---
import '../styles/global.css';
import type { Lang } from '../data/site';
import { ui } from '../i18n';
import Header from '../components/Header.astro';
import { abs, headTags, type JsonLd } from '../lib/seo';
import { ANALYTICS_HEAD } from '../lib/analytics';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  jsonLd: JsonLd;
  alternates?: { en: string; es: string };
  published?: string;
  noindex?: boolean;
  bootable?: boolean;
  rss?: string;
}
const { lang, title, description, image, imageAlt, jsonLd, alternates, published, noindex = false, bootable = false, rss } = Astro.props;
const canonical = abs(Astro.url.pathname);
const t = ui[lang];
const head = headTags({ lang, title, description, canonical, image, imageAlt, jsonLd, alternates, type: published ? 'article' : 'website', ...(published ? { published } : {}) });
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<Fragment set:html={head} />
<Fragment set:html={ANALYTICS_HEAD} />
{noindex && <meta name="robots" content="noindex">}
<meta name="theme-color" content="#0d0e10">
<meta name="color-scheme" content="dark">
<link rel="preload" href="/fonts/geist-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title={t.writingTitle} href={rss ?? (lang === 'es' ? '/es/rss.xml' : '/rss.xml')}>
<script is:inline define:vars={{ bootable }}>
  document.documentElement.classList.add('js');
  try {
    if (bootable && sessionStorage.getItem('bf-booted') !== '1' && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.setAttribute('data-booting', '');
  } catch {}
</script>
</head>
<body>
<div id="stage">
  <div class="v" id="top">
    <Header lang={lang} alternates={alternates} />
    <main id="main" class="wrap">
      <slot />
    </main>
  </div>
</div>
</body>
</html>
