---
import Base from '../../layouts/Base.astro';
import WritingIndex from '../../components/WritingIndex.astro';
import { ui } from '../../i18n';
import { posts } from '../../lib/posts';
import { blogLd, ogImage } from '../../lib/seo';

const lang = 'en';
const list = await posts(lang);
const t = ui[lang];
---
<Base lang={lang} title={t.writingTitle} description={t.writingDescription} image={ogImage('writing')} imageAlt={list.length ? t.ogWritingAlt : t.ogWritingEmptyAlt} jsonLd={blogLd(lang, t.writingTitle, t.writingDescription, '/writing/')} alternates={{ en: '/writing/', es: '/es/writing/' }}>
  <div class="a-plain"><WritingIndex lang={lang} posts={list} /></div>
</Base>
<script src="../../scripts/app.ts"></script>
