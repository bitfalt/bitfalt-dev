---
import Base from '../../layouts/Base.astro';
import Home from '../../components/Home.astro';
import { ui } from '../../i18n';
import { posts } from '../../lib/posts';
import { homeLd, ogImage } from '../../lib/seo';

const lang = 'es';
const list = await posts(lang);
const t = ui[lang];
---
<Base lang={lang} title={t.metaTitle} description={t.metaDescription} image={ogImage('es/index')} imageAlt={t.ogHomeAlt} jsonLd={homeLd(lang, t.metaTitle, '/es/')} alternates={{ en: '/', es: '/es/' }} bootable>
  <Home lang={lang} posts={list} />
</Base>
<script src="../../scripts/app.ts"></script>
